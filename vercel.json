{
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/swing-paper-multi.html",
      "destination": "/api/index?__route=swing_page&page=multi"
    },
    {
      "source": "/intc-paper-lab.html",
      "destination": "/api/index?__route=swing_page&page=paper"
    },
    {
      "source": "/swing-top100.html",
      "destination": "/api/index?__route=sora_page"
    },
    {
      "source": "/swing-radar-chart.html",
      "destination": "/api/index?__route=swing_page&page=chart"
    },
    {
      "source": "/swing-radar.html",
      "destination": "/api/index?__route=swing_page&page=sector"
    },
    {
      "source": "/ai-leader-roadmap.html",
      "destination": "/index.html"
    },
    {
      "source": "/api/:route",
      "destination": "/api/index?__route=:route"
    }
  ],
  "redirects": [
    {
      "source": "/future-leaders.html",
      "destination": "https://gex-future-leaders.harryahn.chatgpt.site",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/leaders_report.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
